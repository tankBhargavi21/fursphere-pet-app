# ==========================================
# FurSphere Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fursphere

# JWT Secret for Session Token Signing
JWT_SECRET=fursphere_super_secret_jwt_key_2026

# Google Gemini API Key (Optional: for live Gemini 1.5 Flash Chat & Vision Photo Scanning)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Twilio SMS Credentials (Optional: for real SMS OTP delivery to mobile phones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
